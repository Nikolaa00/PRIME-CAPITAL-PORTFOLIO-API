meta {
  name: 01 Create Ana
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/clients
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "Ana",
    "currency": "EUR"
  }
}

script:post-response {
  if (res.body?.id) {
    bru.setEnvVar("clientId", String(res.body.id));
  }
}

docs {
  Ana workflow step 1. Expected 201. Sets clientId for the rest of the scenario.
}
